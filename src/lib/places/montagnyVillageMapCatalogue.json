    },
    "inao-denom-894": {
      "note": "Les Paquiers spans Montagny-lès-Buxy and Saint-Vallerin. Its full published boundary is retained."
    },
    "inao-denom-898": {
      "note": "Les Resses spans Montagny-lès-Buxy and Saint-Vallerin. Its full published boundary is retained."
    }
