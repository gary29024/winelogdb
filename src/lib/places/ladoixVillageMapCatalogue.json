  "notes": {
    "inao-denom-549": {
      "note": "Corton spans Aloxe-Corton, Ladoix-Serrigny and Pernand-Vergelesses. This is the full appellation area; a Corton wine without a matched climat does not identify a single vineyard. The source does not separate its red and white production areas. Some named climats, including Clos des Cortons Faiveley, have no separate boundary in this snapshot."
    },
    "inao-denom-550": {
      "note": "Corton-Charlemagne spans all three communes and includes the smaller Charlemagne area. These white-wine appellations overlap Corton but retain separate identities and full boundaries."
    },
    "inao-denom-476": {
      "note": "Charlemagne is a separate white-wine Grand Cru across Aloxe-Corton and Pernand-Vergelesses. Its production area lies within Corton-Charlemagne; the two names do not identify the same boundary."
    },
    "inao-app-192-village": {
      "note": "This overview combines the red and white Ladoix village areas. Choose a colour to see its published boundary; no single vineyard is identified."
    },
    "inao-denom-657": {
      "note": "The white-wine village area for Ladoix. Named village lieux-dits are not mapped individually."
    },
    "inao-denom-2059": {
      "note": "The red-wine village area for Ladoix, also named Ladoix Côte de Beaune in the source. Named village lieux-dits are not mapped individually."
    },
