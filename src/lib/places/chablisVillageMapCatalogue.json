  "notes": {
    "inao-denom-397": {
      "note": "The full Chablis production area spans 17 current communes. Fyé, Milly and Poinchy are now part of Chablis."
    },
    "inao-denom-414": {
      "note": "Partial boundary only: the source covers La Chapelle-Vaupelteigne, Fontenay-près-Chablis and Maligny, but omits the Chablis-Poinchy part of Fourchaume. A Fourchaume wine opens on the broad Premier Cru area."
    },
    "inao-denom-420": {
      "note": "Partial boundary only: the source covers the Fleys part of Mont de Milieu, but omits its Fyé part in Chablis. A Mont de Milieu wine opens on the broad Premier Cru area."
    },
    "inao-denom-438": {
      "note": "The broad Premier Cru production area includes land whose named climat boundary is missing or incomplete. No individual vineyard is inferred for those wines."
    },
    "inao-denom-439": {
      "note": "Chablis Grand Cru is one appellation with seven named climats. La Moutonne spans parts of Vaudésir and Les Preuses. Its own official parcel boundary is unavailable; its wine view has a separately labelled approximate producer outline. This overview shows the whole Grand Cru appellation."
    },
    "inao-denom-440": {
      "note": "One of the seven named climats within the Chablis Grand Cru appellation. The highlight shows the whole official climat, not an individual producer’s holding or cuvée subdivision."
    },
