  "notes": {
    "inao-denom-549": {
      "note": "Corton spans Aloxe-Corton, Ladoix-Serrigny and Pernand-Vergelesses. This is the whole Grand Cru: a Corton without a named vineyard on the label could come from anywhere in it. A few named vineyards, such as Faiveley's Clos des Cortons, have no separate boundary here."
    },
    "inao-denom-550": {
      "note": "Corton-Charlemagne is a white-wine Grand Cru spanning all three villages. It overlaps Corton on the map and includes the smaller Charlemagne area, but it is a separate appellation."
    },
    "inao-denom-476": {
      "note": "Charlemagne is a separate white-wine Grand Cru in Aloxe-Corton and Pernand-Vergelesses. It lies within the Corton-Charlemagne area but is not the same appellation."
    },
    "inao-denom-2348": {
      "note": "One of the named vineyards within the Corton Grand Cru, not a Grand Cru of its own. Its named boundary is for red wine; a white Corton shows the whole Corton area instead."
    },
