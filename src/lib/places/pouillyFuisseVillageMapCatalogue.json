  "notes": {
    "inao-denom-1055": {
      "note": "This is the full published Pouilly-Fuissé white-wine appellation area. Individual village lieux-dits and producer holdings are not mapped separately."
    },
    "inao-denom-1056": {
      "note": "This source designation covers the area eligible for a village wine labelled with a climat name. It is a broad area across all four communes, not the boundary of one climat or a Premier Cru."
    },
    "inao-denom-2876": {
      "note": "Vers Cras spans Fuissé and Solutré-Pouilly. Its full Premier Cru production boundary is retained across both communes."
    },
    "inao-denom-2866": {
      "note": "Aux Quarts is the Pouilly-Fuissé Premier Cru in Chaintré, distinct from Les Quarts in Pouilly-Vinzelles. A Clos des Quarts label selects this full climat; the producer's enclosed holding is not mapped separately."
    },
    "inao-denom-2865": {
      "note": "The broad Premier Cru area covers 22 named climats across Fuissé, Solutré-Pouilly, Vergisson and Chaintré. The classification dates from the 2020 vintage; a village wine is not promoted from its plot name alone."
    },
    "inao-denom-2873": {
      "note": "Les Perrières includes Ferret's Clos de Jeanne and La Baudotte. These labels select the full Premier Cru boundary; their producer subdivisions have no separate geometry here. Clos de Jeanne is distinct from Château Fuissé's Le Clos."
    },
    "inao-denom-2874": {
      "note": "Ferret's Tournant de Pouilly lies within Les Reisses. The map shows the full Les Reisses Premier Cru boundary, not the smaller producer parcel or the separate Pouilly climat."
    },
    "inao-denom-2884": {
      "note": "A Clos de France label selects the full En France Premier Cru boundary. The producer's enclosed holding is not mapped separately."
    },
    "inao-denom-2870": {
      "note": "Le Clos is Château Fuissé's Premier Cru monopole. Ferret's historical Le Clos label refers to a different parcel, now called Clos de Jeanne within Les Perrières."
    }
  },
