{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winelogdb",
  "main": "worker/multiUserEntry.ts",
  "triggers": { "crons": ["*/5 * * * *"] },
  "compatibility_date": "2026-08-01",
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Journal semantic search and Producer Range fallback use Workers AI. Range
  // extraction prefers Z.AI GLM-4.7-Flash through AI Gateway BYOK, then the
  // Cloudflare-hosted Qwen3-30B-A3B, then grounded Gemini.
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "winelogdb", "database_id": "c0f85b35-4210-4541-a807-162e258e083d", "migrations_dir": "src/lib/db/migrations" }],
  // Keep this account on Images Free: 5,000 unique transformations/month,
  // then originals are served as fallback. No Images hosted storage is used.
  "images": { "binding": "IMAGES" },
  "r2_buckets": [{ "binding": "WINE_IMAGES", "bucket_name": "winelog-private" }],
  "queues": {
    "producers": [{ "binding": "RESEARCH_QUEUE", "queue": "winelog-research" }],
    "consumers": [{
      "queue": "winelog-research",
      "max_batch_size": 1,
      "max_batch_timeout": 5,
      "max_retries": 2,
      "retry_delay": 60,
      "dead_letter_queue": "winelog-research-dlq"
    }]
  },
  // One data point per AI call, so spend is a time series the dashboard can
  // chart and alert on. D1 keeps the same numbers for the in-app panel; this is
  // what makes them visible in Cloudflare without a query.
  "analytics_engine_datasets": [{ "binding": "AI_USAGE", "dataset": "winelog_ai_usage" }],
  "vars": {
    "MAX_FILE_BYTES": "10485760",
    "MAX_BATCH_FILES": "12",
    "SEMANTIC_SEARCH_PROVIDER": "workers-ai",
    "AI_GATEWAY_ACCOUNT_ID": "82854e9a6f6a543e9b3abf53d29a08ee",
    "AI_GATEWAY_ID": "winelog",
    "ZAI_GATEWAY_PROVIDER_SLUG": "zai",
    "VERTEX_PROJECT_ID": "gen-lang-client-0265199037",
    "VERTEX_REGION": "global",
    // "true" makes AI Gateway store whole request and response bodies. Turn it
    // on to inspect a failing model response, then turn it back off: these are
    // full research prompts and answers.
    "AI_GATEWAY_LOG_PAYLOADS": "false",
    // What an AI call costs. Every one of these is a price a provider can
    // change without telling us, so they are config: correcting one is an edit
    // here, not a deploy of new logic. Google grounding is billed per search
    // query past its monthly allowance. Workers AI also has a daily free Neuron
    // allocation; the ledger deliberately uses list token prices so model/run
    // comparisons remain conservative and comparable after that allowance.
    "AI_COST_CURRENCY": "HKD",
    "AI_COST_FX_PER_USD": "7.843",
    "AI_COST_GROUNDING_FREE_PER_MONTH": "5000",
    // The fallback for a model with no price of its own below. Nothing the app
    // calls today lands here; it exists so an unrecognised model still costs
    // something rather than nothing.
    "AI_COST_INPUT_USD_PER_M": "0.30",
    "AI_COST_OUTPUT_USD_PER_M": "2.50",
    //
    // ---- HOW TO RECORD A PRICE CHANGE ----------------------------------
    // Do not overwrite a rate that has changed: APPEND a window with the date
    // it takes effect. Every usage event is priced by the window in force on
    // the day it happened, so appending leaves last month's figures alone and
    // the new price starts on its own date with no further edit. Overwrite
    // only to CORRECT a number that was always wrong - that should reprice the
    // history, because the old figure was never true.
    // A window can be dated into the future: the entry below for 2027-01-01 is
    // the end of Gemini 3.7/3.8 Flash introductory pricing, already loaded.
    // --------------------------------------------------------------------
    //
    // USD per million tokens, per model, oldest window first. The flat form
    // {"model":{"input":n,"output":n}} is still accepted and means "always".
    // Standard-tier list prices; the tier multipliers below do the rest.
    // Z.AI BYOK through AI Gateway currently lists GLM-4.7-Flash API tokens as
    // free. Producer Range can now fall back to the separately priced
    // Cloudflare-hosted Qwen3 before spending on grounded Gemini.
    "AI_COST_MODEL_RATES": "{\"gemini-3.1-flash-lite\":[{\"from\":\"2026-01-01\",\"input\":0.25,\"output\":1.50}],\"gemini-3.7-flash\":[{\"from\":\"2026-01-01\",\"input\":0.75,\"output\":3.75},{\"from\":\"2027-01-01\",\"input\":1.50,\"output\":7.50}],\"gemini-3.8-flash\":[{\"from\":\"2026-09-02\",\"input\":0.75,\"output\":3.75},{\"from\":\"2027-01-01\",\"input\":1.50,\"output\":7.50}],\"zai/glm-4.7-flash\":[{\"from\":\"2026-01-19\",\"input\":0,\"output\":0}],\"@cf/zai-org/glm-4.7-flash\":[{\"from\":\"2026-02-13\",\"input\":0.06,\"output\":0.40}],\"@cf/qwen/qwen3-30b-a3b-fp8\":[{\"from\":\"2026-09-16\",\"input\":0.0509,\"output\":0.335}]}",
    // What each service tier bills relative to standard. Batch recognition
    // queues on flex on purpose; priority is here for completeness, nothing
    // asks for it today.
    "AI_COST_TIER_MULTIPLIERS": "{\"flex\":0.5,\"batch\":0.5,\"priority\":1.8}",
    // USD per 1,000 grounded Google Search queries, same dated shape. This is
    // the largest line on the bill, so it gets its own history.
    "AI_COST_GROUNDING_RATES": "[{\"from\":\"2026-01-01\",\"usdPer1k\":14}]",
    // Used only for dates before the first grounding window above.
    "AI_COST_GROUNDING_USD_PER_1K": "14"
  }
}