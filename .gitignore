# CI installs with bun and no lockfile is tracked; keep a locally generated
# npm lockfile out of the repository so it cannot pin a different resolution.
package-lock.json
bun.lock

# Python map-builder caches
__pycache__/
*.py[cod]

# Vintages pipeline downloads (rebuilt by the pipeline, never committed)
scripts/vintages/cache/
