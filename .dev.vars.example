# Local-only secrets. Copy to .dev.vars and fill in; never commit .dev.vars.
# These mirror the secrets set with `wrangler secret put` for a deployment.

# Google web OAuth client. Register APP_URL/api/auth/google/callback exactly.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# The verified Google OIDC sub of the legacy owner. Never use an email here.
OWNER_GOOGLE_SUB=replace-with-your-verified-google-subject

# Internal Worker signing key. Web sessions use opaque HttpOnly cookies.
# Rotate this at cutover to invalidate legacy tokens. At least 32 random characters:
#   openssl rand -base64 48
AUTH_SECRET=use-at-least-32-random-characters

# https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me

# The exact origin the browser loads, checked against for CORS.
APP_URL=http://localhost:5173

# Only when calling Vertex AI through Cloudflare AI Gateway. Leave unset to use
# the Gemini API directly; setting only some gateway values fails at runtime.
# CF_AI_GATEWAY_TOKEN=replace-me
