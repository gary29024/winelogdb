# Local-only secrets. Copy to .dev.vars and fill in; never commit .dev.vars.
# These mirror the secrets set with `wrangler secret put` for a deployment.

# The password you log in with.
APP_PASSWORD=choose-a-local-password

# Signing key for session tokens. At least 32 random characters:
#   openssl rand -base64 48
AUTH_SECRET=use-at-least-32-random-characters

# https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me

# Optional: only needed when SEMANTIC_SEARCH_PROVIDER=gemini and you want a
# separate AI Studio key. If omitted, semantic search reuses GEMINI_API_KEY.
# SEMANTIC_GEMINI_API_KEY=replace-me

# The exact origin the browser loads, checked against for CORS.
APP_URL=http://localhost:5173

# Authenticates WineLog to Cloudflare AI Gateway. Producer range research uses
# the same gateway token for the primary Z.AI custom-provider path. The Z.AI
# provider key itself belongs in AI Gateway BYOK, not in Worker/local secrets.
# CF_AI_GATEWAY_TOKEN=replace-me
