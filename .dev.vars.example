# Local-only secrets. Copy to .dev.vars and fill in; never commit .dev.vars.
# These mirror the secrets set with `wrangler secret put` for a deployment.

# Google web OAuth client. Register APP_URL/api/auth/google/callback exactly.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# The verified Google OIDC sub of the legacy owner. Never use an email here.
# Who owns this deployment. Set ONE of these.
#
# OWNER_EMAIL is the easy one: the address you sign in to Google with, checked
# against a Google-verified claim, and only honoured until the owner account has
# an identity bound - so it is a one-time claim, not a standing key.
OWNER_EMAIL=you@example.com
#
# OWNER_GOOGLE_SUB is exact and takes precedence when set, but you cannot read
# your own Google subject until you have signed in at least once.
# OWNER_GOOGLE_SUB=replace-with-your-verified-google-subject

# Internal Worker signing key. Web sessions use opaque HttpOnly cookies.
# Rotate this at cutover to invalidate legacy tokens. At least 32 random characters:
#   openssl rand -base64 48
AUTH_SECRET=use-at-least-32-random-characters

# https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-me

# Optional: only needed when SEMANTIC_SEARCH_PROVIDER=gemini and you want a
# separate AI Studio key. If omitted, semantic search reuses GEMINI_API_KEY.
# SEMANTIC_GEMINI_API_KEY=replace-me

# The exact origin the browser loads, checked against for CORS.
APP_URL=http://localhost:5173

# Authenticates WineLog to Cloudflare AI Gateway. Producer range research uses
# the same gateway token for the primary Z.AI custom-provider path. The Z.AI
# provider key itself belongs in AI Gateway BYOK, not in Worker/local secrets.
# CF_AI_GATEWAY_TOKEN=replace-me
